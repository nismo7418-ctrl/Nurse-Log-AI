# ============================================================
# .env.example - Configuration NurseLog AI
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne JAMAIS commiter .env dans git !
# ============================================================

# --- Transcription vocale ---
# Backend : "local" (Whisper local, 100% RGPD) ou "openai" (API, DPA requise)
# NURSELOG_TRANSCRIPTION_BACKEND=local
#
# Si backend=openai :
# OPENAI_API_KEY=sk-proj-xxxxx
#
# Si backend=local (défaut) :
#   pip install openai-whisper
#   ffmpeg : Windows → winget install Gyan.FFmpeg | macOS → brew install ffmpeg | Linux → sudo apt install ffmpeg

# --- Autres API Keys (prochaines étapes) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Base de données ---
# Chemin absolu du fichier SQLite (Docker : /app/data/nurselog.db)
# NURSELOG_DB_PATH=./nurselog.db

# --- Authentification ---
# JWT_SECRET_KEY=votre-secret-jwt
# SESSION_EXPIRY_MINUTES=480

# --- Serveur ---
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true

# --- Langue par défaut ---
# APP_LANG=fr

# --- Environnement ---
# DEBUG=false
# LOG_LEVEL=INFO
