# ============================================================
# .env.example - Configuration NurseLog AI
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne JAMAIS commiter .env dans git !
# ============================================================

# --- API Keys (prochaines étapes) ---
# OPENAI_API_KEY=sk-proj-xxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Base de données (phase 2) ---
# DATABASE_URL=sqlite:///nurselog.db
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=xxxx

# --- Authentification ---
# JWT_SECRET_KEY=votre-secret-jwt
# SESSION_EXPIRY_MINUTES=480

# --- Serveur ---
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true

# --- Langue par défaut ---
# APP_LANG=fr

# --- Environnement ---
# DEBUG=false
# LOG_LEVEL=INFO
