# ============================================================
# .env.example - Configuration NurseLog AI
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne JAMAIS commiter .env dans git !
# ============================================================

# --- Reconnaissance vocale ---
# Option A : API OpenAI Whisper (les fichiers audio sont envoyés à OpenAI)
# OPENAI_API_KEY=sk-proj-xxxxx
# Option B : Whisper local 100% RGPD — aucune clé requise, aucune donnée envoyée
#           (installer : pip install openai-whisper)
#           + ffmpeg requis pour décoder l'audio :
#             Windows : winget install Gyan.FFmpeg  (ou choco install ffmpeg)
#             macOS   : brew install ffmpeg
#             Linux   : sudo apt install ffmpeg

# --- Autres API Keys (prochaines étapes) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Base de données (phase 2) ---
# DATABASE_URL=sqlite:///nurselog.db
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=xxxx

# --- Authentification ---
# JWT_SECRET_KEY=votre-secret-jwt
# SESSION_EXPIRY_MINUTES=480

# --- Serveur ---
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true

# --- Langue par défaut ---
# APP_LANG=fr

# --- Environnement ---
# DEBUG=false
# LOG_LEVEL=INFO
